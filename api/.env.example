AWS_REGION=eu-north-1
# Set this to use a locally running AgentCore app instead of boto3/AgentCore:
# AGENT_RUNTIME_URL=http://localhost:8080/invocations
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:eu-north-1:123456789012:runtime/debugforge-agent-XXXXXXXXXX
AGENT_ENDPOINT_NAME=DEFAULT
CORS_ORIGINS=http://localhost:3000
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
